# Docker Compose ortam ayarları. JWT_KEY için en az 32 baytlık rastgele değer üretin.
JWT_KEY=
SEED_DEMO=false
AUTOMATION_ENABLED=true
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=false

# dotnet run için .env otomatik okunmaz; environment veya user-secrets kullanın.
# Jwt__Key=
# ConnectionStrings__Default=Data Source=data/finans-accounting.db
# Seed__Demo=false
# Automation__Enabled=true
# Smtp__Host=localhost
# Smtp__Port=1025
# Smtp__From=
# Smtp__Username=
# Smtp__Password=
# Smtp__EnableSsl=false
